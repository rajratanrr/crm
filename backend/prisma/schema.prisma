generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  SALES
  ACCOUNTANT
  PHOTOGRAPHER
  VIDEOGRAPHER
  EDITOR
}

enum ProjectType {
  WEDDING
  FASHION
}

enum ProjectStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  EDITING
  COMPLETED
  CANCELLED
}

enum BusinessDomain {
  WEDDING
  FASHION
  GENERAL
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum EventType {
  WEDDING
  PRE_WEDDING
  ENGAGEMENT
  RECEPTION
  HALDI
  MEHENDI
  SANGEET
  BIRTHDAY
  CORPORATE
  FASHION
  OTHER
}

enum EventStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
  MID_PAYMENT
  FINAL_PAYMENT
  ADDITIONAL_SERVICE
  ADDITIONAL
  REFUND
}

enum PaymentStatus {
  ADVANCE
  PENDING
  DONE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum EmployeeRole {
  PHOTOGRAPHER
  VIDEOGRAPHER
  DRONE_OPERATOR
  EDITOR
  ALBUM_DESIGNER
  MANAGER
  SALES_EXECUTIVE
  ACCOUNTANT
  STYLIST
  MAKEUP_ARTIST
}

enum AssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum DeliverableType {
  RAW_PHOTOS
  EDITED_PHOTOS
  HIGHLIGHT_VIDEO
  FULL_WEDDING_VIDEO
  CINEMATIC_FILM
  TEASER
  REEL
  ALBUM
  LOOKBOOK
  ECOM_CATALOG
  CAMPAIGN_EDIT
}

enum DeliverableStatus {
  PENDING
  IN_PRODUCTION
  READY
  DELIVERED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

// ─── MODELS ──────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  phone        String?  @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads         Lead[]
  interactions  Interaction[]
  notifications Notification[]

  @@map("users")
}

model Customer {
  id             String         @id @default(uuid())
  customerCode   String         @unique @db.VarChar(30)
  fullName       String         @db.VarChar(150)
  phone          String         @db.VarChar(20)
  alternatePhone String?        @db.VarChar(20)
  email          String?        @db.VarChar(180)
  address        String?        @db.Text
  city           String?        @db.VarChar(100)
  state          String?        @db.VarChar(100)
  pincode        String?        @db.VarChar(10)
  source         String?        @db.VarChar(100)
  clientType     BusinessDomain @default(WEDDING)
  companyName    String?        @db.VarChar(150)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leads          Lead[]
  projects       Project[]
  events         Event[]
  contracts      Contract[]
  payments       Payment[]
  invoices       Invoice[]
  interactions   Interaction[]
  tasks          Task[]
  studioBookings StudioBooking[]

  @@index([customerCode])
  @@index([phone])
  @@index([email])
  @@index([clientType])
  @@map("customers")
}

model Lead {
  id              String         @id @default(uuid())
  leadNumber      String         @unique @db.VarChar(30)
  clientType      BusinessDomain @default(WEDDING)
  name            String         @db.VarChar(150)
  phone           String         @db.VarChar(20)
  email           String?        @db.VarChar(180)
  eventType       EventType?
  shootType       String?        @db.VarChar(100)
  estimatedDate   DateTime?      @db.Date
  estimatedBudget Decimal?       @db.Decimal(12, 2)
  source          String?        @db.VarChar(100)
  status          LeadStatus     @default(NEW)
  assignedTo      String?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assignedUser User?     @relation(fields: [assignedTo], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   String?

  @@index([status])
  @@index([phone])
  @@index([clientType])
  @@map("leads")
}

model Project {
  id            String         @id @default(uuid())
  projectNumber String         @unique @db.VarChar(50)
  name          String         @db.VarChar(200)
  projectType   ProjectType    @default(WEDDING)
  status        ProjectStatus  @default(PLANNING)
  customerId    String
  budget        Decimal        @default(0) @db.Decimal(12, 2)
  startDate     DateTime       @db.Date
  endDate       DateTime?      @db.Date
  
  // Wedding specific fields
  weddingDate   DateTime?      @db.Date
  venue         String?        @db.VarChar(250)
  city          String?        @db.VarChar(100)
  functions     String?        @db.Text

  // Fashion specific fields
  brand          String?       @db.VarChar(150)
  shootType      String?       @db.VarChar(100)
  studioLocation String?       @db.VarChar(200)
  shootDate      DateTime?     @db.Date
  driveLink      String?       @db.Text
  creativeTeam   String?       @db.Text
  modelsInfo     String?       @db.Text
  garmentsInfo   String?       @db.Text

  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  customer            Customer                    @relation(fields: [customerId], references: [id])
  events              Event[]
  contracts           Contract[]
  payments            Payment[]
  tasks               Task[]
  deliverables        Deliverable[]
  studioBookings      StudioBooking[]
  garmentRequirements FashionGarmentRequirement[]
  modelAssignments    FashionProjectModel[]

  @@index([customerId])
  @@index([projectType])
  @@index([status])
  @@map("projects")
}

model Event {
  id                  String      @id @default(uuid())
  eventCode           String      @unique @db.VarChar(30)
  customerId          String
  projectId           String?
  eventName           String      @db.VarChar(200)
  eventType           EventType
  startDate           DateTime    @db.Date
  endDate             DateTime?   @db.Date
  venue               String?     @db.VarChar(250)
  city                String?     @db.VarChar(100)
  guestCount          Int?
  status              EventStatus @default(UPCOMING)
  specialRequirements String?     @db.Text
  notes               String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer     Customer          @relation(fields: [customerId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  subEvents    EventSubEvent[]
  contracts    Contract[]
  assignments  EventAssignment[]
  tasks        Task[]
  deliverables Deliverable[]

  @@index([customerId])
  @@index([projectId])
  @@index([startDate])
  @@index([status])
  @@index([eventType])
  @@map("events")
}

model EventSubEvent {
  id        String    @id @default(uuid())
  eventId   String
  name      String    @db.VarChar(150)
  date      DateTime? @db.Date
  startTime DateTime? @db.Time()
  endTime   DateTime? @db.Time()
  venue     String?   @db.VarChar(250)
  notes     String?   @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_sub_events")
}

model Package {
  id          String         @id @default(uuid())
  name        String         @db.VarChar(150)
  domain      BusinessDomain @default(WEDDING)
  description String?        @db.Text
  basePrice   Decimal        @db.Decimal(12, 2)
  duration    String?        @db.VarChar(100)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  services  PackageService[]
  contracts Contract[]

  @@map("packages")
}

model PackageService {
  id          String  @id @default(uuid())
  packageId   String
  serviceName String  @db.VarChar(150)
  description String? @db.Text
  quantity    Int     @default(1)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_services")
}

model Contract {
  id                 String         @id @default(uuid())
  contractNumber     String         @unique @db.VarChar(50)
  customerId         String
  eventId            String?
  projectId          String?
  packageId          String?
  contractDate       DateTime       @db.Date
  subtotal           Decimal        @db.Decimal(12, 2)
  discount           Decimal        @default(0) @db.Decimal(12, 2)
  tax                Decimal        @default(0) @db.Decimal(12, 2)
  finalAmount        Decimal        @db.Decimal(12, 2)
  status             ContractStatus @default(DRAFT)
  termsAndConditions String?        @db.Text
  signedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  customer     Customer       @relation(fields: [customerId], references: [id])
  event        Event?         @relation(fields: [eventId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  package      Package?       @relation(fields: [packageId], references: [id])
  items        ContractItem[]
  payments     Payment[]
  invoices     Invoice[]
  deliverables Deliverable[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@map("contracts")
}

model ContractItem {
  id          String  @id @default(uuid())
  contractId  String
  serviceName String  @db.VarChar(150)
  description String? @db.Text
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_items")
}

model Payment {
  id            String          @id @default(uuid())
  contractId    String?
  projectId     String?
  customerId    String
  domain        BusinessDomain  @default(WEDDING)
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentType   PaymentType
  paymentStatus PaymentStatus?  // ADVANCE=received, PENDING=not received, DONE=received
  paymentDate   DateTime        @db.Date
  transactionId String?         @db.VarChar(150)
  notes         String?         @db.Text
  reference     String?         @db.VarChar(255)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])

  @@index([contractId])
  @@index([projectId])
  @@index([customerId])
  @@index([paymentDate])
  @@index([domain])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @db.VarChar(50)
  contractId    String
  customerId    String
  issueDate     DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  pdfUrl        String?       @db.Text
  createdAt     DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

model Employee {
  id             String       @id @default(uuid())
  name           String       @db.VarChar(150)
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(180)
  role           EmployeeRole
  specialization String?      @db.VarChar(150)
  availability   String?      @db.VarChar(100)
  joiningDate    DateTime?    @db.Date
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments EventAssignment[]
  tasks       Task[]
  attendances Attendance[]

  @@map("employees")
}

model EventAssignment {
  id         String           @id @default(uuid())
  eventId    String
  employeeId String
  role       String?          @db.VarChar(100)
  callTime   DateTime?        @db.Time()
  status     AssignmentStatus @default(ASSIGNED)
  notes      String?          @db.Text

  event    Event    @relation(fields: [eventId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([eventId, employeeId])
  @@map("event_assignments")
}

model Interaction {
  id              String          @id @default(uuid())
  customerId      String
  userId          String?
  type            InteractionType
  subject         String?         @db.VarChar(200)
  notes           String?         @db.Text
  interactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@map("interactions")
}

model Task {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(200)
  description String?      @db.Text
  assignedTo  String?
  customerId  String?
  eventId     String?
  projectId   String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?    @db.Date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignedEmployee Employee? @relation(fields: [assignedTo], references: [id])
  customer         Customer? @relation(fields: [customerId], references: [id])
  event            Event?    @relation(fields: [eventId], references: [id])
  project          Project?  @relation(fields: [projectId], references: [id])

  @@map("tasks")
}

model Deliverable {
  id           String            @id @default(uuid())
  eventId      String?
  projectId    String?
  contractId   String?
  domain       BusinessDomain    @default(WEDDING)
  type         DeliverableType
  quantity     Int               @default(1)
  dueDate      DateTime?         @db.Date
  status       DeliverableStatus @default(PENDING)
  deliveryDate DateTime?         @db.Date
  deliveryLink String?           @db.Text
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event    Event?    @relation(fields: [eventId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@map("deliverables")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String   @db.VarChar(200)
  message   String   @db.Text
  type      String?  @db.VarChar(50)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─── STUDIO FASHION SPECIFIC MODELS ──────────────────

model Model {
  id               String   @id @default(uuid())
  name             String   @db.VarChar(150)
  agency           String?  @db.VarChar(150)
  phone            String?  @db.VarChar(20)
  email            String?  @db.VarChar(180)
  instagram        String?  @db.VarChar(100)
  gender           String?  @db.VarChar(50)
  height           String?  @db.VarChar(50)
  measurements     String?  @db.VarChar(100)
  dayRate          Decimal? @db.Decimal(10, 2)   // kept for DB compat, hidden from UI
  status           String   @default("AVAILABLE") @db.VarChar(50) // kept for DB compat
  shootCategories  String?  @db.Text             // JSON array e.g. ["Saree","Kurti"]
  preferredShootType String? @db.VarChar(100)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectAssignments FashionProjectModel[]

  @@map("fashion_models")
}

model FashionGarmentRequirement {
  id        String   @id @default(uuid())
  projectId String
  clothType String   @db.VarChar(100)  // e.g. "Saree", "Kurti", "Bottom"
  dressName String   @db.VarChar(200)  // specific dress/product name
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("fashion_garment_requirements")
}

model FashionProjectModel {
  id        String   @id @default(uuid())
  projectId String
  modelId   String
  clientId  String?
  modelRate Decimal  @default(0) @db.Decimal(12, 2)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model   Model    @relation(fields: [modelId], references: [id])

  @@unique([projectId, modelId])
  @@index([projectId])
  @@map("fashion_project_models")
}

model Garment {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(150)
  brand          String?  @db.VarChar(150)
  category       String?  @db.VarChar(100)
  size           String?  @db.VarChar(50)
  color          String?  @db.VarChar(50)
  condition      String   @default("EXCELLENT") @db.VarChar(50)
  status         String   @default("AVAILABLE") @db.VarChar(50)
  shootReference String?  @db.VarChar(200)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("fashion_garments")
}

model StudioBooking {
  id            String   @id @default(uuid())
  bookingNumber String   @unique @db.VarChar(50)
  studioBay     String   @db.VarChar(100)
  date          DateTime @db.Date
  startTime     String?  @db.VarChar(20)
  endTime       String?  @db.VarChar(20)
  projectId     String?
  customerId    String?
  bookedBy      String?  @db.VarChar(150)
  purpose       String?  @db.VarChar(200)
  status        String   @default("CONFIRMED") @db.VarChar(50)
  cost          Decimal? @db.Decimal(10, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([date])
  @@index([studioBay])
  @@map("studio_bookings")
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  checkIn    String?          @db.VarChar(20)
  checkOut   String?          @db.VarChar(20)
  notes      String?          @db.Text
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendances")
}

model Expense {
  id            String         @id @default(uuid())
  expenseNumber String         @unique @db.VarChar(50)
  category      String         @db.VarChar(100)
  domain        BusinessDomain @default(GENERAL)
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime       @db.Date
  paymentMethod PaymentMethod  @default(BANK_TRANSFER)
  vendor        String?        @db.VarChar(150)
  description   String?        @db.Text
  receiptUrl    String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([expenseDate])
  @@index([domain])
  @@map("expenses")
}
