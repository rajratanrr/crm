generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  SALES
  ACCOUNTANT
  PHOTOGRAPHER
  VIDEOGRAPHER
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum EventType {
  WEDDING
  PRE_WEDDING
  ENGAGEMENT
  RECEPTION
  HALDI
  MEHENDI
  SANGEET
  BIRTHDAY
  CORPORATE
  FASHION
  OTHER
}

enum EventStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
  FINAL_PAYMENT
  ADDITIONAL_SERVICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum EmployeeRole {
  PHOTOGRAPHER
  VIDEOGRAPHER
  DRONE_OPERATOR
  EDITOR
  ALBUM_DESIGNER
  MANAGER
  SALES_EXECUTIVE
  ACCOUNTANT
}

enum AssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum DeliverableType {
  RAW_PHOTOS
  EDITED_PHOTOS
  HIGHLIGHT_VIDEO
  FULL_WEDDING_VIDEO
  CINEMATIC_FILM
  TEASER
  REEL
  ALBUM
}

enum DeliverableStatus {
  PENDING
  IN_PRODUCTION
  READY
  DELIVERED
}

// ─── MODELS ──────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  phone        String?  @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads         Lead[]
  interactions  Interaction[]
  notifications Notification[]

  @@map("users")
}

model Customer {
  id             String   @id @default(uuid())
  customerCode   String   @unique @db.VarChar(30)
  fullName       String   @db.VarChar(150)
  phone          String   @db.VarChar(20)
  alternatePhone String?  @db.VarChar(20)
  email          String?  @db.VarChar(180)
  address        String?  @db.Text
  city           String?  @db.VarChar(100)
  state          String?  @db.VarChar(100)
  pincode        String?  @db.VarChar(10)
  source         String?  @db.VarChar(100)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads        Lead[]
  events       Event[]
  contracts    Contract[]
  payments     Payment[]
  invoices     Invoice[]
  interactions Interaction[]
  tasks        Task[]

  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Lead {
  id              String     @id @default(uuid())
  customerId      String?
  eventType       EventType?
  eventDate       DateTime?  @db.Date
  estimatedBudget Decimal?   @db.Decimal(12, 2)
  source          String?    @db.VarChar(100)
  status          LeadStatus @default(NEW)
  assignedTo      String?
  notes           String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customer   Customer? @relation(fields: [customerId], references: [id])
  assignedUser User?   @relation(fields: [assignedTo], references: [id])

  @@index([status])
  @@index([eventDate])
  @@index([assignedTo])
  @@map("leads")
}

model Event {
  id                  String      @id @default(uuid())
  customerId          String
  eventName           String      @db.VarChar(200)
  eventType           EventType
  startDate           DateTime    @db.Date
  endDate             DateTime?   @db.Date
  venue               String?     @db.VarChar(250)
  city                String?     @db.VarChar(100)
  guestCount          Int?
  status              EventStatus @default(UPCOMING)
  specialRequirements String?     @db.Text
  notes               String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer     Customer          @relation(fields: [customerId], references: [id])
  subEvents    EventSubEvent[]
  contracts    Contract[]
  assignments  EventAssignment[]
  tasks        Task[]
  deliverables Deliverable[]

  @@index([customerId])
  @@index([startDate])
  @@index([status])
  @@index([eventType])
  @@map("events")
}

model EventSubEvent {
  id        String    @id @default(uuid())
  eventId   String
  name      String    @db.VarChar(150)
  date      DateTime? @db.Date
  startTime DateTime? @db.Time()
  endTime   DateTime? @db.Time()
  venue     String?   @db.VarChar(250)
  notes     String?   @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_sub_events")
}

model Package {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  basePrice   Decimal  @db.Decimal(12, 2)
  duration    String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services  PackageService[]
  contracts Contract[]

  @@map("packages")
}

model PackageService {
  id          String  @id @default(uuid())
  packageId   String
  serviceName String  @db.VarChar(150)
  description String? @db.Text
  quantity    Int     @default(1)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_services")
}

model Contract {
  id                 String         @id @default(uuid())
  contractNumber     String         @unique @db.VarChar(50)
  customerId         String
  eventId            String
  packageId          String?
  contractDate       DateTime       @db.Date
  subtotal           Decimal        @db.Decimal(12, 2)
  discount           Decimal        @default(0) @db.Decimal(12, 2)
  tax                Decimal        @default(0) @db.Decimal(12, 2)
  finalAmount        Decimal        @db.Decimal(12, 2)
  status             ContractStatus @default(DRAFT)
  termsAndConditions String?        @db.Text
  signedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  event    Event          @relation(fields: [eventId], references: [id])
  package  Package?       @relation(fields: [packageId], references: [id])
  items    ContractItem[]
  payments Payment[]
  invoices Invoice[]
  deliverables Deliverable[]

  @@index([customerId])
  @@index([eventId])
  @@index([status])
  @@map("contracts")
}

model ContractItem {
  id          String  @id @default(uuid())
  contractId  String
  serviceName String  @db.VarChar(150)
  description String? @db.Text
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_items")
}

model Payment {
  id            String        @id @default(uuid())
  contractId    String
  customerId    String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentType   PaymentType
  paymentDate   DateTime      @db.Date
  transactionId String?       @db.VarChar(150)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([contractId])
  @@index([customerId])
  @@index([paymentDate])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @db.VarChar(50)
  contractId    String
  customerId    String
  issueDate     DateTime      @db.Date
  dueDate       DateTime?     @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  pdfUrl        String?       @db.Text
  createdAt     DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

model Employee {
  id             String       @id @default(uuid())
  name           String       @db.VarChar(150)
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(180)
  role           EmployeeRole
  specialization String?      @db.VarChar(150)
  availability   String?      @db.VarChar(100)
  joiningDate    DateTime?    @db.Date
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments EventAssignment[]
  tasks       Task[]

  @@map("employees")
}

model EventAssignment {
  id         String           @id @default(uuid())
  eventId    String
  employeeId String
  role       String?          @db.VarChar(100)
  callTime   DateTime?        @db.Time()
  status     AssignmentStatus @default(ASSIGNED)
  notes      String?          @db.Text

  event    Event    @relation(fields: [eventId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([eventId, employeeId])
  @@map("event_assignments")
}

model Interaction {
  id              String          @id @default(uuid())
  customerId      String
  userId          String?
  type            InteractionType
  subject         String?         @db.VarChar(200)
  notes           String?         @db.Text
  interactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@map("interactions")
}

model Task {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(200)
  description String?      @db.Text
  assignedTo  String?
  customerId  String?
  eventId     String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?    @db.Date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignedEmployee Employee? @relation(fields: [assignedTo], references: [id])
  customer         Customer? @relation(fields: [customerId], references: [id])
  event            Event?    @relation(fields: [eventId], references: [id])

  @@map("tasks")
}

model Deliverable {
  id           String           @id @default(uuid())
  eventId      String
  contractId   String?
  type         DeliverableType
  quantity     Int              @default(1)
  dueDate      DateTime?        @db.Date
  status       DeliverableStatus @default(PENDING)
  deliveryDate DateTime?        @db.Date
  deliveryLink String?          @db.Text
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event    Event     @relation(fields: [eventId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@map("deliverables")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String   @db.VarChar(200)
  message   String   @db.Text
  type      String?  @db.VarChar(50)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
